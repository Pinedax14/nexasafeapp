{
  "name": "nexasafe-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "expo export --platform android",
    "audit:gate": "node scripts/audit-gate.js",
    "map:leaflet": "node scripts/generar-leaflet.js",
    "start:dev-client": "expo start --dev-client"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "leaflet": "1.9.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.15.0"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/features/**/domain/**/*.ts",
      "src/features/**/data/**/*.ts",
      "src/core/storage/**/*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ]
  },
  "overrides": {
    "postcss": "^8.5.28",
    "shell-quote": "1.12.0"
  }
}
