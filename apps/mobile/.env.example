# Copia este archivo como .env y completa con los datos de nexasafe-dev
# (Supabase -> Project Settings -> API Keys). Solo la llave "Publishable":
# nunca la "Secret" ni "service_role".
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
